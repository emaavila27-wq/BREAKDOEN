# URL pública del sitio, sin barra al final (opcional; por defecto https://breakdownfit.com)
SITE_URL=

# Mercado Pago → Tus integraciones → Credenciales de producción → Access Token
MP_ACCESS_TOKEN=
# Mercado Pago → Tus integraciones → Webhooks → "Clave secreta" (opcional pero recomendado)
MP_WEBHOOK_SECRET=

# Resend → API Keys
RESEND_API_KEY=
# Remitente (opcional): por defecto "BREAKDOWN <planes@breakdownfit.com>" según lib/config.js
EMAIL_FROM=
# Tu mail: recibe las consultas y el aviso de cada venta
COACH_EMAIL=
