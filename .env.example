# URL pública del sitio, sin barra al final (ej. https://breakdown.vercel.app)
SITE_URL=

# Mercado Pago → Tus integraciones → Credenciales de producción → Access Token
MP_ACCESS_TOKEN=
# Mercado Pago → Tus integraciones → Webhooks → "Clave secreta" (opcional pero recomendado)
MP_WEBHOOK_SECRET=

# Resend → API Keys
RESEND_API_KEY=
# Remitente con tu dominio verificado en Resend (ej. "BREAKDOWN <planes@tudominio.com>")
EMAIL_FROM=
# Tu mail: recibe las consultas y el aviso de cada venta
COACH_EMAIL=
